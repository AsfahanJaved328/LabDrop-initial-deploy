# Copy this file to .env and fill in real values. Never commit .env.
# All of these are optional - LabDrop works with no .env file at all
# using sensible defaults (same-origin signaling server, 500 MB limit, STUN only).

# Only needed if the signaling server is NOT on the same origin as this
# frontend (e.g. you deploy frontend and backend separately).
# VITE_SERVER_URL=https://labdrop-server.up.railway.app

# Maximum single file size LabDrop will accept, in megabytes.
VITE_MAX_FILE_SIZE_MB=500

# Optional TURN relay, needed when phone and computer are on a network
# (e.g. a locked-down university Wi-Fi) that blocks direct WebRTC
# connections. Without this, LabDrop falls back to STUN-only, which
# works on most home/hotspot networks but not all campus networks.
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=labdrop
# VITE_TURN_CREDENTIAL=change-me
