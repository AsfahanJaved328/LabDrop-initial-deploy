# Copy this file to .env and fill in real values. Never commit .env.

# Port the signaling server listens on.
PORT=4000

# "development" or "production". In production the server also serves
# the built client (client/dist) and enables a strict CSP.
NODE_ENV=development

# The exact origin your frontend is served from (no trailing slash).
# Dev:        http://localhost:5173
# Production: https://labdrop.up.railway.app  (or your own domain)
CLIENT_ORIGIN=http://localhost:5173

# How long an idle session stays valid before it auto-expires.
SESSION_TTL_MINUTES=15
